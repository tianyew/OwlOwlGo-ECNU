# Server-only DeepSeek configuration. Restart API after editing.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=45

# Application logs; relative paths resolve from code/backend, not the working directory.
OWL_LOG_FILE=logs/app.log
OWL_LOG_LEVEL=INFO
OWL_LOG_MAX_BYTES=10485760
OWL_LOG_BACKUP_COUNT=5

# Account settings are read from this file; process environment takes precedence.
# Local Docker PostgreSQL; match POSTGRES_PASSWORD and POSTGRES_PORT in root .env.
DATABASE_URL=postgresql+psycopg://owlowlgo:owlowlgo@127.0.0.1:5432/owlowlgo
# Empty DATABASE_URL explicitly selects legacy JSON storage; connection failures never fall back.
# OWL_ACCOUNT_FILE=/absolute/path/to/accounts.json
# Learning progress remains JSON; importing accounts keeps the same user IDs.
# OWL_LEARNING_FILE=/absolute/path/to/learning.json
# Enable Secure cookies when using HTTPS; keep false for local HTTP.
OWL_SECURE_COOKIES=false
OWL_SEED_DEMO_ACCOUNT=false
OWL_SESSION_SECONDS=604800
# Fixed-window limits; successful attempts count too.
OWL_AUTH_WINDOW_SECONDS=300
OWL_LOGIN_ACCOUNT_LIMIT=10
OWL_LOGIN_IP_LIMIT=60
OWL_REGISTER_IP_LIMIT=20
