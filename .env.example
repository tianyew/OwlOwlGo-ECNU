# Application
APP_ENV=development
APP_NAME=OwlOwlGo
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace-with-a-local-development-key
DATABASE_URL=postgresql+psycopg://owlowlgo:owlowlgo@localhost:5432/owlowlgo
POSTGRES_PASSWORD=owlowlgo
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# AI provider (leave blank until configured locally)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=


# Account settings: local API reads code/backend/.env; Compose also loads this file.
# OWL_ACCOUNT_FILE=/absolute/path/to/accounts.json
# Set true only when serving through HTTPS.
OWL_SECURE_COOKIES=false

# Optional admin/admin local demo; false disables creation, not existing accounts.
OWL_SEED_DEMO_ACCOUNT=false
